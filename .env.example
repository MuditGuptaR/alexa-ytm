# Your VPS Public Domain managed by Traefik / DNS
DOMAIN=ytm.yourdomain.com

# 32-character random secret to sign audio streaming tokens (generate with: openssl rand -hex 16)
STREAM_SECRET=replace_with_a_secure_random_string_32_chars

# Your Skill ID from the Alexa Developer Console (e.g. amzn1.ask.skill.xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx)
ALEXA_SKILL_ID=amzn1.ask.skill.xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Amazon Request Signature verification (set to true in production, false for local testing with Postman)
VERIFY_ALEXA_SIGNATURE=true

# Name of your existing Docker network where Traefik runs (check with: docker network ls)
TRAEFIK_NETWORK=traefik_default

# Traefik cert resolver name (as configured in your traefik.yml)
TRAEFIK_CERT_RESOLVER=letsencrypt

